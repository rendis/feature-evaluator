# =============================================================================
# Feature Evaluator — Backend Configuration
# Copy this file to .env and adjust values for your environment.
# Viper reads these as env vars (underscore-separated keys).
# =============================================================================

# --- Server ---
SERVER_PORT=8080                    # HTTP port
SERVER_SHUTDOWN_TIMEOUT=10s         # Graceful shutdown timeout

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_HEALTHCHECK_PERIOD=1m
POSTGRES_CONNECT_TIMEOUT=10s

# --- Redis ---
REDIS_URI=localhost:6379            # Redis address (host:port)

# --- Authentication ---
AUTH_DISABLED=false                 # true = skip JWT validation, use dev user
DEV_USER_EMAIL=dev@local.dev # Dev user email (only when AUTH_DISABLED=true)
DEV_USER_ROLE=owner                 # Dev user role: owner|admin|editor|viewer
AUTH_SECRETS_MASTER_KEY=ZOzjiLsDddhJJghkFo5U0ep//2BKw1yV413F1aebnkM=  # Base64-encoded 32-byte AES key for AuthProfile secrets

# --- OIDC (required when AUTH_DISABLED=false) ---
OIDC_ISSUER=                        # OIDC provider issuer URL (e.g. https://auth.example.com)
OIDC_AUDIENCE=                      # Expected JWT audience

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173  # Comma-separated origins

# --- Rate Limiting (GCRA via Redis, fail-open) ---
RATE_LIMIT_EVAL=500                 # Max eval requests per second
RATE_LIMIT_ADMIN=60                 # Max admin requests per second

# --- Logging ---
LOG_LEVEL=info                      # debug|info|warn|error
LOG_FORMAT=text                     # text (dev) | json (prod)
