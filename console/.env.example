# =============================================================================
# Feature Evaluator — Frontend Configuration
# Copy this file to .env and adjust values for your environment.
# Vite exposes only VITE_* variables to the client bundle.
# =============================================================================

# --- API ---
VITE_API_URL=http://localhost:8080/features  # Backend base URL

# --- Authentication ---
VITE_AUTH_DISABLED=true                       # true = bypass OIDC, use backend dev user

# --- OIDC (required when VITE_AUTH_DISABLED is not "true") ---
VITE_OIDC_AUTHORITY=                          # OIDC provider URL (e.g. https://auth.example.com)
VITE_OIDC_CLIENT_ID=                          # OIDC client ID
VITE_OIDC_REDIRECT_URI=                       # Callback URL (default: {origin}/auth/callback)
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=           # Post-logout URL (default: {origin})
